# ---------------------------------------------------------------------------
# Authentification
# ---------------------------------------------------------------------------
# Générer avec : openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_MINUTES=720

# Compte admin créé au tout premier démarrage (ignoré si un admin existe déjà).
DEFAULT_ADMIN_EMAIL=admin@innovahub226.com
DEFAULT_ADMIN_PASSWORD=change_me_before_first_boot

# ---------------------------------------------------------------------------
# Deriv
# ---------------------------------------------------------------------------
# Deriv-App-ID enregistré via https://api.deriv.com/dashboard (type "Native apps" / PAT)
DERIV_APP_ID=your_deriv_app_id_here
# Token partenaire IB — sans lui, le bouton d'inscription pointe vers deriv.com sans commission.
DERIV_AFFILIATE_TOKEN=

# ---------------------------------------------------------------------------
# Paiements Mobile Money (FedaPay)
# ---------------------------------------------------------------------------
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://api1.innovahub226.com

# DANGER : autorise le provider `manual` qui active un abonnement SANS paiement
# réel (endpoint /billing/dev-pay). Doit rester vide/false en production.
ALLOW_MANUAL_PAYMENTS=false

# ---------------------------------------------------------------------------
# Signaux de trading (analyse des indices synthétiques, aucun ordre passé)
# ---------------------------------------------------------------------------
# Moteur de signaux actif par défaut ; false = pas de moteur (routes /signals
# vides, flux /ws/signals indisponible).
SIGNALS_ENABLED=true
# Symboles analysés, séparés par des virgules. Vide = défaut :
# R_75,R_100,BOOM1000,CRASH1000,BOOM500,CRASH500
SIGNAL_SYMBOLS=

# ---------------------------------------------------------------------------
# Copy trading
# ---------------------------------------------------------------------------
# AVERTISSEMENT : le copy trading conserve (chiffrés) les tokens API Deriv des
# suiveurs, capables de passer des ordres sur LEURS comptes. À n'activer
# qu'après décision explicite du client.
COPY_TRADING_ENABLED=false
# Clé Fernet de chiffrement des tokens suiveurs (obligatoire si activé).
# Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ne jamais la commiter ; la perdre rend illisibles les tokens déjà stockés.
COPY_TOKEN_KEY=
