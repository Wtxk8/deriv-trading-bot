# ---------------------------------------------------------------------------
# Authentification
# ---------------------------------------------------------------------------
# Générer avec : openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_MINUTES=720

# Compte admin créé au tout premier démarrage (ignoré si un admin existe déjà).
DEFAULT_ADMIN_EMAIL=admin@innovahub226.com
DEFAULT_ADMIN_PASSWORD=change_me_before_first_boot

# ---------------------------------------------------------------------------
# Deriv
# ---------------------------------------------------------------------------
# Deriv-App-ID enregistré via https://api.deriv.com/dashboard (type "Native apps" / PAT)
DERIV_APP_ID=your_deriv_app_id_here
# Token partenaire IB — sans lui, le bouton d'inscription pointe vers deriv.com sans commission.
DERIV_AFFILIATE_TOKEN=

# ---------------------------------------------------------------------------
# Paiements Mobile Money (FedaPay)
# ---------------------------------------------------------------------------
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://api1.innovahub226.com

# DANGER : autorise le provider `manual` qui active un abonnement SANS paiement
# réel (endpoint /billing/dev-pay). Doit rester vide/false en production.
ALLOW_MANUAL_PAYMENTS=false
